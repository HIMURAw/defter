{
  "name": "defter",
  "version": "0.3.0",
  "description": "Paper notebooks for Obsidian: type in animated handwriting, draw and highlight with the mouse, on ruled pages stored as plain Markdown.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node --test test/*.test.ts",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "author": "Umut",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "~5.9.3"
  }
}
